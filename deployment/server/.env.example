# Public frontend uses same-origin /api through Nginx. Leave blank unless the upstream build requires an absolute origin.
PUBLIC_API_URL=
SHARED_AGENT_TOKEN=replace-with-random-token
POSTGRES_PASSWORD=replace-with-random-password
INTERNAL_KEY=replace-with-random-key

# IDs from the private, restored demo database. Export them before running deploy-public-demos.sh.
DOCSGPT_AGENT_ID=replace-with-agent-uuid
DOCSGPT_SOURCE_ID=replace-with-source-uuid

# Bind to localhost and publish through a TLS reverse proxy.
DOCSGPT_BIND_ADDRESS=127.0.0.1
DOCSGPT_FRONTEND_PORT=5173

# Optional deployment-script overrides.
# DEMO_BASE_DIR=/opt/agent-demos
# DEMO_OWNER=ubuntu:ubuntu
