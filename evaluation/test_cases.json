{
  "schema_version": "1.0",
  "description": "DocsGPT 企业客服知识库离线评测集。将真实 Agent 回答导出为 JSONL 后，由 scripts/evaluate_rag.py 计算结果。评测集不调用模型，也不会生成或伪造回答。",
  "cases": [
    {
      "id": "CS-001",
      "category": "售后-质量问题",
      "question": "质量问题退货运费谁承担？普通快递最高报销多少？",
      "expected_behavior": "answer",
      "required_patterns": ["(非人为|质量问题)", "(平台|商家).{0,12}(承担|负责)", "12\\s*元"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
      "id": "CS-002",
      "category": "售后-质量问题",
      "question": "商品有质量问题，售后申请需要在多久内提交？",
      "expected_behavior": "answer",
      "required_patterns": ["(签收后|签收之日).{0,8}(15|十五).{0,4}(日|天)"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
      "id": "CS-003",
      "category": "售后-质量问题",
      "question": "质量问题售后申请要提供什么凭证？",
      "expected_behavior": "answer",
      "required_patterns": ["(照片|视频|检测说明)", "(清晰|凭证)"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
      "id": "CS-004",
      "category": "售后-物流",
      "question": "质量问题寄回商品能到付吗？",
      "expected_behavior": "answer",
      "required_patterns": ["(不建议|不支持|不要).{0,10}到付", "(拒收|普通快递|运单号)"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
      "id": "CS-005",
      "category": "售后-非质量问题",
      "question": "不想要了退货，寄回运费由谁承担？",
      "expected_behavior": "answer",
      "required_patterns": ["非质量", "((用户|买家).{0,12}(承担|负责).{0,12}(运费|寄回)|(运费|寄回).{0,12}(用户|买家).{0,12}(承担|负责))"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
      "id": "CS-006",
      "category": "售后-非质量问题",
      "question": "七天无理由退货，商品需要满足什么条件？",
      "expected_behavior": "answer",
      "required_patterns": ["(外包装|配件|赠品|说明书)", "(完整|二次销售)"],
      "source_hints": ["customer_service_after_sales_policy", "customer_service_rag_optimized"]
    },
    {
      "id": "CS-007",
      "category": "售后-退款",
      "question": "普通商品退货退款质检通常需要多久？",
      "expected_behavior": "answer",
      "required_patterns": ["(1|一).{0,3}(3|三).{0,4}(工作日|天)", "(签收|质检)"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
      "id": "CS-008",
      "category": "售后-退款",
      "question": "大件商品退款质检要几天？",
      "expected_behavior": "answer",
      "required_patterns": ["(3|三).{0,3}(5|五).{0,4}(工作日|天)"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
      "id": "CS-009",
      "category": "售后-退款",
