      "expected_behavior": "answer",
      "required_patterns": ["(微信|支付宝)", "(1|一).{0,3}(3|三).{0,4}(工作日|天)"],
      "source_hints": ["customer_service_rag_optimized", "customer_service_after_sales_policy"]
    },
    {
